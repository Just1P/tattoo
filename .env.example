# Copier ce fichier vers .env puis renseigner les valeurs ci-dessous.
# Aucun secret réel ici — .env est ignoré par git (.gitignore).

# Base de données Postgres (docker compose up -d, ou une base Neon/hébergée)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tattoo_pro"

# Better Auth — secret aléatoire (ex: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Optionnel : nécessaire uniquement pour tester la connexion "Se connecter avec Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (envoi d'emails transactionnels) — https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Tattoo Pro <onboarding@resend.dev>"

# UploadThing (upload d'images) — https://uploadthing.com/dashboard
# Optionnel : nécessaire uniquement pour tester l'upload d'avatar/œuvres
UPLOADTHING_TOKEN=""
